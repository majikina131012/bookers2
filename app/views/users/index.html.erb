<div class="row">
  <%= render 'books/sidebar', user: @user, book: @book %>
    <div class="col-md-8 offset-md-1">
      <h1>Users</h1>
      <table class="table">
        <tr>
          <th>image</th>
          <th>name</th>
          <th></th>
          <th>フォロー数</th>
          <th>フォロワー数</th>
          <th></th>
        </tr>
        <% @users.each do |user| %>
        <tr>
          <td><%= image_tag user.get_profile_image(100,100) %></td>
          <td><%=user.name %></td>
          <td><%= link_to 'Show', user_path(user.id), class:"btn btn-secondary" %></td>
          <td id="follows_count_<%= user.id %>">
            <%= render 'relationships/follows_count', user: user %>
          </td>
          <td id="followers_count_<%= user.id %>">
            <%= render 'relationships/followers_count', user: user %>
          </td>
          <td id="relationships_btn_<%= user.id %>">
            <%= render 'relationships/btn', user: user %>
          </td>
        </tr>
        <% end %>
      </table>
    </div>
  </div>
</div>